---
interface Props {
  data: {
    title: string;
    subtitle: string;
    branches: Array<{
      name: string;
      address: string;
      phone: string;
      mapsLink: string;
    }>;
  };
}

const { data } = Astro.props;

// 1. Define the type for a single branch
type Branch = {
  name: string;
  address: string;
  phone: string;
  mapsLink: string;
};
---

<section id="locations" class="py-16 px-4 md:px-12 bg-[#121010]">
  <div class="max-w-7xl mx-auto">
    
    <div class="flex items-center justify-between mb-8">
      <span class="text-gray-400 text-sm font-medium hover:text-white transition cursor-pointer">
        {data.subtitle}
      </span>
      <h2 class="text-3xl md:text-5xl font-black text-white">
        {data.title}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {/* 2. Apply the type to the map parameter here */}
      {data.branches.map((branch: Branch) => (
        <div class="bg-[#E55347] text-white p-6 md:p-8 rounded-lg shadow-xl flex flex-col justify-between items-start text-right">
          <div class="w-full mb-6">
            <h3 class="text-2xl md:text-3xl font-black mb-2">
              {branch.name}
            </h3>
            <p class="text-white/90 text-sm md:text-base font-medium">
              {branch.address}
            </p>
          </div>

          <div class="flex items-center gap-3 w-full">
            <a
              href={`tel:${branch.phone.replace(/\s+/g, '')}`}
              class="border border-white/40 hover:border-white px-4 py-1.5 rounded text-sm font-bold text-white transition hover:bg-white hover:text-[#E55347]"
            >
              {branch.phone}
            </a>
            <a
              href={branch.mapsLink}
              target="_blank"
              class="border border-white/40 hover:border-white px-4 py-1.5 rounded text-sm font-bold text-white transition hover:bg-white hover:text-[#E55347]"
            >
              الاتجاهات
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>